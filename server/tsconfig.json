{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"], // Keep this! Bun includes 'process'
    "outDir": "./dist",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  // FIX: Ensure your specific file or root files are included here
  "include": [
    "src/**/*", 
    "validations/**/*", 
    "routes/**/*", 
    "controllers/**/*", 
    "config/**/*", 
    "types/**/*",
    "app.ts", 
    "index.ts",
    "*.ts" // This includes any root-level TypeScript files
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
