      "value": ""
    },
    {
      "key": "accessTokenStudent",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "courseId",
      "value": ""
    },
    {
      "key": "moduleId",
      "value": ""
    },
    {
      "key": "lessonId",
      "value": ""
    },
    {
      "key": "assignmentId",
      "value": ""
    },
    {
      "key": "submissionId",
      "value": ""
    },
    {
      "key": "studentId",
      "value": ""
    },
    {
      "key": "certificateId",
      "value": ""
    }
  ]
}
