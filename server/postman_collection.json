{
  "info": {
    "name": "LMS API Test Collection",
    "description": "Sample requests for the LMS API mounted at /api/v1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Instructor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Instructor\",\n  \"email\": \"alice.instructor@example.com\",\n  \"password\": \"Passw0rd1\",\n  \"confirmPassword\": \"Passw0rd1\",\n  \"role\": \"INSTRUCTOR\"\n}"
            }
          }
        },
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Student\",\n  \"email\": \"bob.student@example.com\",\n  \"password\": \"Passw0rd1\",\n  \"confirmPassword\": \"Passw0rd1\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice.instructor@example.com\",\n  \"password\": \"Passw0rd1\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob.student@example.com\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"NewPassw0rd1\"\n}"
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/courses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Intro to Node.js\",\n  \"description\": \"Build backend services with Node.js and Express.\",\n  \"category\": \"Programming\",\n  \"level\": \"BEGINNER\",\n  \"duration\": 120,\n  \"thumbnail\": \"https://example.com/node-course.png\"\n}"
            }
          }
        },
        {
          "name": "Get Course by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/courses/{{courseId}}"
          }
        },
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses?search=node&level=BEGINNER&limit=10&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["courses"],
              "query": [
                { "key": "search", "value": "node" },
                { "key": "level", "value": "BEGINNER" },
                { "key": "limit", "value": "10" },
                { "key": "page", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Enroll Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessTokenStudent}}" }
            ],
            "url": "{{baseUrl}}/courses/{{courseId}}/enroll"
          }
        }
      ]
    },
    {
      "name": "Modules",
      "item": [
        {
          "name": "Create Module",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/courses/{{courseId}}/modules",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Getting Started\",\n  \"description\": \"Overview and setup\",\n  \"order\": 1\n}"
            }
          }
        },
        {
          "name": "List Modules for Course",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/courses/{{courseId}}/modules"
          }
        },
        {
          "name": "Update Module",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/modules/{{moduleId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Getting Started with Node.js\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Lessons",
      "item": [
        {
          "name": "Create Lesson",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/modules/{{moduleId}}/lessons",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Install Node\",\n  \"description\": \"Install Node.js and npm.\",\n  \"content\": \"Use node -v to verify installation.\",\n  \"videoUrl\": \"https://example.com/video\",\n  \"order\": 1\n}"
            }
          }
        },
        {
          "name": "Get Lesson by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/lessons/{{lessonId}}"
          }
        },
        {
          "name": "Complete Lesson",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessTokenStudent}}" }
            ],
            "url": "{{baseUrl}}/lessons/{{lessonId}}/complete"
          }
        }
      ]
    },
    {
      "name": "Assignments",
      "item": [
        {
          "name": "Create Assignment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/lessons/{{lessonId}}/assignments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Setup Node App\",\n  \"description\": \"Create a simple Node.js app that returns Hello World.\",\n  \"instructions\": \"Use Express and include a README.\",\n  \"dueDate\": \"2028-01-01T23:59:59Z\",\n  \"maxScore\": 100\n}"
            }
          }
        },
        {
          "name": "Get Assignment by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/assignments/{{assignmentId}}"
          }
        },
        {
          "name": "List Assignments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/assignments"
          }
        },
        {
          "name": "Submit Assignment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessTokenStudent}}" }
            ],
            "url": "{{baseUrl}}/assignments/{{assignmentId}}/submit",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "path/to/solution.zip"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Grading",
      "item": [
        {
          "name": "Grade Submission",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/grading/submissions/{{submissionId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"score\": 95,\n  \"feedback\": \"Great work!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Certificates",
      "item": [
        {
          "name": "Generate Certificate",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/certificates/generate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": \"{{courseId}}\",\n  \"studentId\": \"{{studentId}}\"\n}"
            }
          }
        },
        {
          "name": "List Certificates",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/certificates"
          }
        },
        {
          "name": "Get Certificate by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/certificates/{{certificateId}}"
          }
        },
        {
          "name": "Download Certificate",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/certificates/{{certificateId}}/download"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
